{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(php artisan:*)",
      "Bash(npm run:*)",
      "Bash(composer:*)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Bash(php artisan db:wipe:*)",
      "Bash(sudo *)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"$(date): Notification hook fired, CLAUDE_NOTIFICATION=${CLAUDE_NOTIFICATION:-<empty>}\" >> /tmp/claude_notification_debug.log; afplay /System/Library/Sounds/Ping.aiff 2>/dev/null; /opt/homebrew/bin/terminal-notifier -message \"${CLAUDE_NOTIFICATION:-需要您的回覆}\" -title \"Claude Code\" -subtitle \"等待確認\" 2>/dev/null"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/ronald/.claude/scripts/notify_when_idle.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/ronald/.claude/scripts/notify_when_idle.sh ask"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/ronald/.claude/scripts/notify_when_idle.sh ask"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/ronald/.claude/scripts/notify_when_idle.sh ask"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'FILE=$(jq -r \".tool_input.file_path // \\\"\\\"\" 2>/dev/null); echo \"$FILE\" | grep -qE \"/\\.claude/(agents/[^/]+\\.md|skills/[^/]+/SKILL\\.md|rules/[^/]+\\.md|settings\\.json|CLAUDE\\.md)$\" && python3 ~/.claude/scripts/update_usage.py 2>/dev/null || true'"
          },
          {
            "type": "command",
            "command": "bash -c 'FILE=$(jq -r \".tool_input.file_path // \\\"\\\"\" 2>/dev/null); echo \"$FILE\" | grep -qE \"/\\.claude/(skills/|agents/|rules/|scripts/|settings\\.json|USAGE\\.md|CLAUDE\\.md)\" && node /Users/ronald/AI/Projects/bclaude/bin/sync.js >> /tmp/bclaude-sync.log 2>&1 & true'"
          }
        ]
      }
    ]
  }
}
