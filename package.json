{
  "name": "bclaude",
  "version": "1.1.0",
  "description": "Personal Claude Code configuration installer — skills, agents, rules, hooks",
  "type": "module",
  "bin": {
    "bclaude": "bin/cli.js"
  },
  "files": [
    "bin/",
    "src/",
    "skills/",
    "agents/",
    "rules/",
    "scripts/",
    "templates/",
    "profiles.json",
    "skills-registry.json"
  ],
  "scripts": {
    "dev": "node bin/cli.js",
    "dry-run": "node bin/cli.js --dry-run",
    "sync": "node bin/sync.js",
    "sync:commit": "node bin/sync.js --commit",
    "sync:push": "node bin/sync.js --push"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.3.0",
    "ora": "^8.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "dotfiles",
    "config"
  ],
  "author": "Ronald Jian",
  "license": "MIT"
}
